# ─────────────────────────────────────────────────────────────
# INVESTMENTS — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# .env.local NO se versiona. Nunca subas credenciales reales.
# ─────────────────────────────────────────────────────────────

# ── Servidor (privadas) ──────────────────────────────────────
# Cadena de conexión de Neon PostgreSQL (Dashboard de Neon → Connection string).
# Ejemplo de formato: postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
DATABASE_URL=

# ── Correo Transaccional (Resend HTTP API) ───────────────────
# Para activar el envío real de correos de verificación, recuperación de contraseña
# y notificaciones B2B, configura tu API Key de Resend y el remitente verificado.
# Si se omite en desarrollo, los enlaces se registran en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM="INVESTMENTS <no-reply@investments.pe>"

# ── Aprovisionamiento de Administrador Inicial (Opcional) ────
# Variables utilizadas por `npm run db:create-admin` (nunca uses contraseñas por defecto).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=INVESTMENTS

# ── Públicas (se exponen al navegador) ───────────────────────
# URL pública del sitio (SEO, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Datos de contacto oficiales. Si se dejan vacíos, no se muestran.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_CONTACT_HOURS=

# Redes sociales oficiales (URL completa). Si se dejan vacías, se muestran como "pronto".
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# ── Catálogo y Paginación (Opcional) ─────────────────────────
# Cantidad de productos por página en el catálogo público (por defecto: 12)
CATALOG_PAGE_SIZE=12

# ── Fase 5: Pasarelas de Pago y Webhooks (Opcionales en Desarrollo) ──
# Separación de entorno para simulador Sandbox interno (en producción debe ser false):
ENABLE_PAYMENT_SANDBOX=true

# Mercado Pago Perú (https://www.mercadopago.com.pe/developers)
# Entorno ("sandbox" para pruebas TEST-... | "production" para credenciales APP_USR-...):
MERCADOPAGO_ENV=sandbox
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Secreto oficial del Webhook de Mercado Pago (panel Tus integraciones → Webhooks → Clave secreta)
MERCADOPAGO_WEBHOOK_SECRET=

# Culqi Perú (https://docs.culqi.com) — Clave pública (pk_test_...) y privada (sk_test_...)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Secreto HMAC-SHA256 para autenticar webhooks genéricos / Culqi en /api/webhooks/payments
PAYMENT_WEBHOOK_SECRET=

# Datos corporativos para instrucciones de Transferencia Bancaria / CCI
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_RUC=
BANK_TRANSFER_ACCOUNT_PEN=
BANK_TRANSFER_CCI_PEN=

# ── Fase 5: Facturación Electrónica SUNAT vía PSE / OSE (Nubefact Compatible) ──
# Bandera explícita de activación (debe ser "true" únicamente cuando desees timbrar comprobantes reales):
SUNAT_PSE_ENABLED=false
# Entorno del PSE/OSE ("sandbox" para homologación/beta | "production" para emisión oficial ante SUNAT):
SUNAT_PSE_ENV=sandbox
# Nombre del proveedor autorizado (ej. "Nubefact PSE/OSE"):
SUNAT_PSE_PROVIDER_NAME=Nubefact PSE/OSE
# Ruta HTTP API y Token provistos por tu PSE/OSE autorizado por SUNAT:
SUNAT_PSE_API_URL=
SUNAT_PSE_API_TOKEN=
# Series autorizadas en tu cuenta del PSE/OSE (ej. B001 / BBB1 para Boleta y F001 / FFF1 para Factura):
SUNAT_PSE_SERIE_BOLETA=
SUNAT_PSE_SERIE_FACTURA=


